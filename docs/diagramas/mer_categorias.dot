digraph G {graph[bgcolor=white,pad=0.2,nodesep=0.3,ranksep=0.5];node[shape=box,fontname=Arial,fontsize=11,style=filled,fillcolor="#f3f6fa",margin="0.15,0.1"];edge[fontname=Arial,fontsize=9,color="#34465d"];rankdir=TB;node[shape=record];
 conv[label="{p1_convocatoria|PK id|plazas totales, gestión y número}"];cargo[label="{p1_cargo|PK id|tipo y unidad}"];oferta[label="{p1_oferta|PK id|FK convocatoria y cargo|UQ convocatoria y cargo|plazas, alcance y múltiple}"];
 req[label="{p1_requisito_config|PK id y FK oferta_id|código, obligatorio y documental}"];area[label="{p1_area_examen|PK id y FK oferta_id|porcentaje y activo}"];
 post[label="{p1_postulacion|PK id|FK convocatoria y cargo|estado y acumulados}"];doc[label="{p1_expediente|PK id|FK postulación y requisito|PDF, nombre y SHA256}"];asig[label="{p1_asignacion_area|PK FK postulación, evaluador y área}"];nota[label="{p1_nota_area|PK FK asignación|puntaje, motivo y fecha}"];emp[label="{p1_resolucion_empate|PK FK postulación|autorización, acta, actor y fecha}"];usuario[label="{p1_usuario|PK id|rol, facultad y carrera}"];
 conv->oferta; cargo->oferta;oferta->req;oferta->area;conv->post;cargo->post;usuario->post;post->doc;req->doc;post->asig;usuario->asig;area->asig;asig->nota;post->emp;oferta->post[style=dashed,label="pareja convocatoria y cargo"];}