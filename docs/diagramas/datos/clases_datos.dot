digraph Datos {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.38", ranksep="1.15", splines=polyline, outputorder=edgesfirst, fontname="Times New Roman", fontsize=18, label="class Diagrama de clases del dominio de auxiliaturas", labelloc=t];
node [shape=plain, fontname="Times New Roman", fontsize=16];
edge [dir=none, color="#4a4540", penwidth=1, fontname="Times New Roman", fontsize=13, labeldistance=1.7, labelangle=25];
p1_usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- registro: varchar(20)</TD></TR><TR><TD ALIGN="LEFT">- nombres: varchar(100)</TD></TR><TR><TD ALIGN="LEFT">- apellidos: varchar(120)</TD></TR><TR><TD ALIGN="LEFT">- rol: varchar(20)</TD></TR><TR><TD ALIGN="LEFT">- telefono: varchar(30)</TD></TR><TR><TD ALIGN="LEFT">- correo: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- activo: boolean</TD></TR><TR><TD ALIGN="LEFT">- creado_en: timestamptz</TD></TR></TABLE>>];
p1_convocatoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Convocatoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- codigo: varchar(30)</TD></TR><TR><TD ALIGN="LEFT">- titulo: varchar(200)</TD></TR><TR><TD ALIGN="LEFT">- fecha_inicio: date</TD></TR><TR><TD ALIGN="LEFT">- fecha_fin: date</TD></TR><TR><TD ALIGN="LEFT">- estado: varchar(20)</TD></TR><TR><TD ALIGN="LEFT">- plazas: integer</TD></TR><TR><TD ALIGN="LEFT">- creado_en: timestamptz</TD></TR></TABLE>>];
p1_cargo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Cargo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- nombre: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- unidad: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- activo: boolean</TD></TR></TABLE>>];
p1_oferta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Oferta</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- convocatoria_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- cargo_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- plazas: integer</TD></TR></TABLE>>];
p1_area_examen [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>AreaExamen</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- convocatoria_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- cargo_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- area: varchar(80)</TD></TR><TR><TD ALIGN="LEFT">- peso: numeric(5,2)</TD></TR></TABLE>>];
p1_postulacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Postulacion</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- convocatoria_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- postulante_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- cargo_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- estado: varchar(30)</TD></TR><TR><TD ALIGN="LEFT">- observacion: text</TD></TR><TR><TD ALIGN="LEFT">- puntaje_meritos: numeric(7,2)</TD></TR><TR><TD ALIGN="LEFT">- puntaje_examen: numeric(7,2)</TD></TR><TR><TD ALIGN="LEFT">- puntaje_final: numeric(7,2)</TD></TR><TR><TD ALIGN="LEFT">- plaza_asignada: boolean</TD></TR><TR><TD ALIGN="LEFT">- creado_en: timestamptz</TD></TR><TR><TD ALIGN="LEFT">- evaluacion_version: bigint</TD></TR></TABLE>>];
p1_expediente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Expediente</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- postulacion_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- descripcion: varchar(200)</TD></TR><TR><TD ALIGN="LEFT">- ruta_archivo: text</TD></TR><TR><TD ALIGN="LEFT">- tipo_mime: varchar(120)</TD></TR><TR><TD ALIGN="LEFT">- creado_en: timestamptz</TD></TR><TR><TD ALIGN="LEFT">- nombre_archivo: varchar(180)</TD></TR><TR><TD ALIGN="LEFT">- contenido: bytea</TD></TR><TR><TD ALIGN="LEFT">- sha256: char(64)</TD></TR></TABLE>>];
p1_evaluacion_requisito [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>EvaluacionRequisito</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- postulacion_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- requisito: varchar(200)</TD></TR><TR><TD ALIGN="LEFT">- cumple: boolean</TD></TR><TR><TD ALIGN="LEFT">- observacion: text</TD></TR><TR><TD ALIGN="LEFT">- evaluador_correo: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- fecha: timestamptz</TD></TR></TABLE>>];
p1_merito [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Merito</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- postulacion_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- criterio: varchar(200)</TD></TR><TR><TD ALIGN="LEFT">- puntaje: numeric(7,2)</TD></TR><TR><TD ALIGN="LEFT">- observacion: text</TD></TR><TR><TD ALIGN="LEFT">- evaluador_correo: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- fecha: timestamptz</TD></TR></TABLE>>];
p1_examen [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Examen</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- postulacion_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- puntaje: numeric(7,2)</TD></TR><TR><TD ALIGN="LEFT">- evaluador_correo: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- observacion: text</TD></TR><TR><TD ALIGN="LEFT">- fecha: timestamptz</TD></TR><TR><TD ALIGN="LEFT">- area: varchar(80)</TD></TR></TABLE>>];
p1_desempate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Desempate</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- postulacion_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- evaluacion_version: bigint</TD></TR><TR><TD ALIGN="LEFT">- puntaje: numeric(7,2)</TD></TR><TR><TD ALIGN="LEFT">- prioridad: integer</TD></TR><TR><TD ALIGN="LEFT">- justificacion: varchar(500)</TD></TR><TR><TD ALIGN="LEFT">- actor: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- fecha: timestamptz</TD></TR></TABLE>>];
p1_asignacion_evaluador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>AsignacionEvaluador</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- postulacion_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- evaluador_id: bigint</TD></TR><TR><TD ALIGN="LEFT">- tipo: varchar(40)</TD></TR></TABLE>>];
p1_convocatoria -> p1_oferta [label="ofrece", taillabel="1", headlabel="0..*"];
p1_cargo -> p1_oferta [label="se oferta en", taillabel="1", headlabel="0..*"];
p1_oferta -> p1_area_examen [label="define áreas", taillabel="1", headlabel="0..*"];
p1_convocatoria -> p1_postulacion [label="recibe", taillabel="1", headlabel="0..*"];
p1_cargo -> p1_postulacion [label="es solicitado en", taillabel="1", headlabel="0..*"];
p1_usuario -> p1_postulacion [label="presenta", taillabel="1", headlabel="0..*"];
p1_postulacion -> p1_expediente [label="adjunta", taillabel="1", headlabel="0..*"];
p1_postulacion -> p1_evaluacion_requisito [label="se verifica con", taillabel="1", headlabel="0..*"];
p1_postulacion -> p1_merito [label="acredita", taillabel="1", headlabel="0..*"];
p1_postulacion -> p1_examen [label="se califica con", taillabel="1", headlabel="0..*"];
p1_postulacion -> p1_desempate [label="se resuelve con", taillabel="1", headlabel="0..1"];
p1_postulacion -> p1_asignacion_evaluador [label="recibe evaluadores mediante", taillabel="1", headlabel="0..*"];
p1_usuario -> p1_asignacion_evaluador [label="evalúa mediante", taillabel="1", headlabel="0..*"];
}
