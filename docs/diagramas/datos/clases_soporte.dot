digraph Datos {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.38", ranksep="1.15", splines=polyline, outputorder=edgesfirst, fontname="Times New Roman", fontsize=18, label="class Persistencia de auditoría y soporte del correo", labelloc=t];
node [shape=plain, fontname="Times New Roman", fontsize=16];
edge [dir=none, color="#4a4540", penwidth=1, fontname="Times New Roman", fontsize=13, labeldistance=1.7, labelangle=25];
graph [pack=true, packmode="array_u3"];
p1_auditoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Auditoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- fecha: timestamptz</TD></TR><TR><TD ALIGN="LEFT">- actor: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- accion: varchar(80)</TD></TR><TR><TD ALIGN="LEFT">- entidad: varchar(80)</TD></TR><TR><TD ALIGN="LEFT">- entidad_id: varchar(80)</TD></TR><TR><TD ALIGN="LEFT">- detalle: text</TD></TR></TABLE>>];
p1_correo_control [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>ControlCorreo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- mensaje_id: varchar(255)</TD></TR><TR><TD ALIGN="LEFT">- remitente: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- asunto: text</TD></TR><TR><TD ALIGN="LEFT">- estado: varchar(30)</TD></TR><TR><TD ALIGN="LEFT">- respuesta_asunto: text</TD></TR><TR><TD ALIGN="LEFT">- respuesta_cuerpo: text</TD></TR><TR><TD ALIGN="LEFT">- exito: boolean</TD></TR><TR><TD ALIGN="LEFT">- intentos: integer</TD></TR><TR><TD ALIGN="LEFT">- ultimo_error: text</TD></TR><TR><TD ALIGN="LEFT">- siguiente_intento: timestamptz</TD></TR><TR><TD ALIGN="LEFT">- creado_en: timestamptz</TD></TR><TR><TD ALIGN="LEFT">- actualizado_en: timestamptz</TD></TR><TR><TD ALIGN="LEFT">- admitido_en: timestamptz</TD></TR></TABLE>>];
p1_adjunto_correo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>AdjuntoCorreo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- mensaje_id: varchar(255)</TD></TR><TR><TD ALIGN="LEFT">- nombre: varchar(180)</TD></TR><TR><TD ALIGN="LEFT">- contenido: bytea</TD></TR><TR><TD ALIGN="LEFT">- sha256: char(64)</TD></TR><TR><TD ALIGN="LEFT">- creado_en: timestamptz</TD></TR></TABLE>>];
p1_correo_procesado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>CorreoProcesado</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- id: bigserial</TD></TR><TR><TD ALIGN="LEFT">- mensaje_id: varchar(255)</TD></TR><TR><TD ALIGN="LEFT">- remitente: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- asunto: text</TD></TR><TR><TD ALIGN="LEFT">- exito: boolean</TD></TR><TR><TD ALIGN="LEFT">- procesado_en: timestamptz</TD></TR></TABLE>>];
p1_confirmacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Confirmacion</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- mensaje_id: varchar(255)</TD></TR><TR><TD ALIGN="LEFT">- remitente: varchar(160)</TD></TR><TR><TD ALIGN="LEFT">- token_hash: varchar(64)</TD></TR><TR><TD ALIGN="LEFT">- orden_json: text</TD></TR><TR><TD ALIGN="LEFT">- vence_en: timestamptz</TD></TR><TR><TD ALIGN="LEFT">- confirmacion_id: varchar(255)</TD></TR><TR><TD ALIGN="LEFT">- usado: boolean</TD></TR></TABLE>>];
p1_resultado_orden [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>ResultadoOrden</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- mensaje_id: varchar(255)</TD></TR><TR><TD ALIGN="LEFT">- exito: boolean</TD></TR><TR><TD ALIGN="LEFT">- respuesta_asunto: text</TD></TR><TR><TD ALIGN="LEFT">- respuesta_cuerpo: text</TD></TR><TR><TD ALIGN="LEFT">- ejecutado_en: timestamptz</TD></TR></TABLE>>];
p1_servicio_estado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>EstadoServicio</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- clave: varchar(80)</TD></TR><TR><TD ALIGN="LEFT">- valor: text</TD></TR><TR><TD ALIGN="LEFT">- actualizado_en: timestamptz</TD></TR></TABLE>>];
persona [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F8EACB" COLOR="#8E887D"><TR><TD><B>Persona</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- ci: varchar(20)</TD></TR><TR><TD ALIGN="LEFT">- nombres: varchar(100)</TD></TR><TR><TD ALIGN="LEFT">- apellidos: varchar(120)</TD></TR><TR><TD ALIGN="LEFT">- ocupacion: varchar(80)</TD></TR><TR><TD ALIGN="LEFT">- telefono: varchar(30)</TD></TR><TR><TD ALIGN="LEFT">- celular: varchar(30)</TD></TR><TR><TD ALIGN="LEFT">- correo: varchar(160)</TD></TR></TABLE>>];
p1_correo_control -> p1_adjunto_correo [label="conserva PDF", taillabel="1", headlabel="0..1"];
}
