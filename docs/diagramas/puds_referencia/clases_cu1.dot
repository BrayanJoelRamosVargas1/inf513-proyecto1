digraph G {graph[rankdir=LR,bgcolor="white",pad="0.2",nodesep=".35",ranksep=".65"];node[shape=plain,fontname="Times New Roman",fontsize=17,margin=".18,.12",style=filled,fillcolor="#F8EACB"];edge[fontname="Times New Roman",fontsize=14,color="#403b32",arrowsize=.7];p[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#F8EACB"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>ProcesadorOrden</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- catalogo: CatalogoComandos<BR ALIGN="LEFT"/>- repo: RepositorioProyecto</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ procesar(...) : Resultado<BR ALIGN="LEFT"/>- validar(Orden) : String</TD></TR></TABLE>>];r[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#F8EACB"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>RepositorioPostgres</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- ds: DataSource</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- insertarUsuario(...)<BR ALIGN="LEFT"/>- listarUsuarios(...)</TD></TR></TABLE>>];i[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#F8EACB"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>«interface» RepositorioProyecto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ejecutarIdempotente(...)<BR ALIGN="LEFT"/>+ confirmarOrden(...)</TD></TR></TABLE>>];o[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#F8EACB"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>«record» Orden</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">comando: String<BR ALIGN="LEFT"/>parametros: List</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ comando()<BR ALIGN="LEFT"/>+ parametros()</TD></TR></TABLE>>];z[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" BGCOLOR="#F8EACB"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><B>«record» Resultado</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">exito: boolean<BR ALIGN="LEFT"/>asunto / cuerpo: String</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ok(...)<BR ALIGN="LEFT"/>+ error(...)</TD></TR></TABLE>>];p->i[label="depende de"];r->i[style=dashed,arrowhead=empty,label="implementa"];p->o[label="lee"];p->z[label="devuelve"];}