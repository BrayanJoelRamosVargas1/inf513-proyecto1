digraph G { graph [bgcolor="white",pad="0.2",nodesep="0.35",ranksep="0.6",fontname="Times New Roman",fontsize=13];node [shape=box,fontname="Times New Roman",fontsize=12,margin="0.14,0.10",color="#403b32",style="filled",fillcolor="#F8EACB"];edge [fontname="Times New Roman",fontsize=10,color="#403b32",arrowsize=0.7]; rankdir=TB;node[shape=record];main[label="{Main|ejecutarCiclo()|esperaReintento()}"];parser[label="{AnalizadorOrden|analizar(asunto) : Orden}"];orden[label="{Orden|comando : String|parametros : List}"];proc[label="{ProcesadorOrden|procesar(id, remitente, orden)}"];catalogo[label="{CatalogoComandos|buscar(comando)|todos()}"];iface[label="{RepositorioProyecto|ejecutarIdempotente()|solicitarConfirmacion()|confirmarOrden()}"];repo[label="{RepositorioPostgres|registrarEntrada()|correosPendientes()|guardarRespuesta()}"];mail[label="{PasarelaCorreo|noProcesados()|responder()|marcarProcesado()}"];resultado[label="{Resultado|exito|asunto|cuerpo}"];main->parser;parser->orden;main->proc;proc->catalogo;proc->iface;repo->iface[arrowhead=empty,style=dashed];main->mail;main->repo;proc->resultado; }