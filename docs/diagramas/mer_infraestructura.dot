digraph G { graph [bgcolor="white",pad="0.2",nodesep="0.35",ranksep="0.6",fontname="Arial",fontsize=13];node [shape=box,fontname="Arial",fontsize=12,margin="0.14,0.10",color="#34465d",style="filled",fillcolor="#f3f6fa"];edge [fontname="Arial",fontsize=10,color="#34465d",arrowsize=0.7]; rankdir=TB;node[shape=record];cola[label="{p1_correo_control|PK mensaje_id|remitente y asunto|estado y respuesta|intentos y siguiente_intento}"];pdf[label="{p1_adjunto_correo|PK FK mensaje_id|nombre, contenido y SHA256}"];conf[label="{p1_confirmacion|PK mensaje_id|token_hash y remitente|orden_json y vence_en|usado y confirmacion_id}"];res[label="{p1_resultado_orden|PK mensaje_id|respuesta y exito}"];proc[label="{p1_correo_procesado|PK id|UQ mensaje_id|procesado_en}"];aud[label="{p1_auditoria|PK id|actor y accion|entidad y detalle}"];estado[label="{p1_servicio_estado|PK clave|valor y actualizado_en}"];persona[label="{persona|PK ci|nombres y apellidos|ocupacion, telefono y celular|UQ correo}"];cola->pdf[label="1 a 0..1 FK"];cola->conf[style=dashed,label="correlación lógica"];cola->res[style=dashed,label="correlación lógica"];cola->proc[style=dashed,label="correlación lógica"];res->aud[style=dashed,label="misma transacción"];persona->aud[style=dashed,label="INSPER auditado"]; }