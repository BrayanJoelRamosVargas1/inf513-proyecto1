digraph G { graph[rankdir=LR,bgcolor="white",nodesep=.25,ranksep=.5];node[shape=box,fontname="Arial",fontsize=12];edge[fontname="Arial",fontsize=10];
conv[label="p1_convocatoria\nPK id\nfechas, estado, plazas totales"];
cargo[label="p1_cargo\nPK id\nnombre, activo"];
oferta[label="p1_oferta\nPK FK convocatoria_id, cargo_id\nplazas por categoría"];
area[label="p1_area_examen\nPK FK convocatoria_id, cargo_id\nPK area\npeso porcentual"];
usuario[label="p1_usuario\nPK id\nUQ registro, correo\nrol, activo"];
post[label="p1_postulacion\nPK id\nFK convocatoria_id, cargo_id\nFK postulante_id\nUQ convocatoria, postulante, cargo\nestado, puntajes, evaluacion_version"];
exp[label="p1_expediente\nPK id\nFK postulacion_id\nreferencia o PDF, SHA256"];
req[label="p1_evaluacion_requisito\nPK id\nFK postulacion_id\nrequisito, cumple, evaluador"];
mer[label="p1_merito\nPK id\nFK postulacion_id\ncriterio, puntaje, evaluador"];
exa[label="p1_examen\nPK id\nFK postulacion_id\narea, puntaje, evaluador"];
asig[label="p1_asignacion_evaluador\nPK id\nFK postulacion_id, evaluador_id\ntipo o área"];
des[label="p1_desempate\nPK FK postulacion_id\nevaluacion_version, puntaje\nprioridad, justificacion, actor"];
conv->oferta;cargo->oferta;oferta->area[label="1 a N, FK compuesta"];
conv->post;cargo->post;usuario->post[label="postulante"];
post->exp;post->req;post->mer;post->exa;post->asig;post->des[label="1 a 0..1"];
usuario->asig[label="evaluador"];
}